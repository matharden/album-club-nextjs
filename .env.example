# Copy to .env.local for development. On Vercel, set these as project env vars.
# All are read at build time — a change requires a rebuild.

# Where the club's content comes from (see README, "Data repos"). Leave both
# unset to run on sample-data/.
# A local checkout of a data repo, for editing content:
ALBUM_CLUB_DATA_DIR=""
# Or a GitHub repo to clone, as owner/name. The token is only for private repos.
ALBUM_CLUB_DATA_REPO=""
ALBUM_CLUB_DATA_TOKEN=""

# The site settings below default to the data repo's site.yml. Set one here to
# override it.

# Shown in the header and appended to every page title.
SITE_TITLE=""

# Used as the metadata base for absolute URLs.
SITE_URL=""

# Google Font family loaded in the document head and exposed as --font-name.
GOOGLE_FONT_NAME=""

# Optional. When unset, no analytics script is injected.
GOOGLE_ANALYTICS_ID=""

# Optional. For the /getter authoring tool only. Spotify tokens expire after an
# hour; grab a fresh one from https://developer.spotify.com/ when you need it.
NEXT_PUBLIC_SPOTIFY_TOKEN=""
